# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insta_automate?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-min-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Application Public Host URL (Used for CSRF validation and OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Mode ("true" for simulated demo mode, "false" for live Meta API)
DEMO_MODE="false"

# Data Encryption Key (32-character hex or string used for AES-256-GCM token encryption)
ENCRYPTION_KEY="your-32-character-encryption-key-for-aes-256"

# Scheduled Publishing Cron Worker Secret (Required for production cron executions)
CRON_SECRET="your-secure-cron-secret-token"

# Meta & Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN="your_instagram_user_access_token_here"
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
GRAPH_API_VERSION="v21.0"

# File Storage Configuration (local or s3)
STORAGE_TYPE="local"
UPLOAD_DIR="./public/uploads"
